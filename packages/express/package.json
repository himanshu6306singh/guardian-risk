{
  "name": "guardian-risk-express",
  "version": "0.1.0",
  "description": "Express middleware plugin for guardian-risk — adds request signals",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["guardian-risk", "guardian-risk-express", "express", "middleware", "risk", "security"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himanshu6306singh/guardian-risk.git",
    "directory": "packages/express"
  },
  "homepage": "https://github.com/himanshu6306singh/guardian-risk/tree/main/packages/express#readme",
  "bugs": {
    "url": "https://github.com/himanshu6306singh/guardian-risk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "guardian-risk": "^0.2.0",
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "guardian-risk": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
