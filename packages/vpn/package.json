{
  "name": "guardian-risk-vpn",
  "version": "0.1.0",
  "description": "VPN and proxy detection plugin for guardian-risk — adds network risk signals",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["guardian-risk", "vpn", "proxy", "tor", "ip", "fraud", "risk"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "guardian-risk": "workspace:*"
  },
  "devDependencies": {
    "guardian-risk": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
