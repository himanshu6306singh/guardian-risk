{
  "name": "guardian-risk-logger",
  "version": "0.1.0",
  "description": "Audit logging plugin for guardian-risk — logs reports and matched rules",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["guardian-risk", "logger", "audit", "logging", "risk", "security"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "guardian-risk": "workspace:*"
  },
  "devDependencies": {
    "guardian-risk": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
