{
  "name": "guardian-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "build": "pnpm --filter guardian-risk build && pnpm --filter \"./packages/{express,browser,redis,vpn,logger}\" build",
    "test": "pnpm --filter guardian-risk test && pnpm --filter \"./packages/{express,browser,redis,vpn}\" test",
    "test:watch": "pnpm --filter guardian-risk test -- --watch",
    "test:coverage": "pnpm --filter guardian-risk test:coverage",
    "lint": "eslint packages/core/src",
    "typecheck": "tsc -b",
    "publish:core": "pnpm --filter guardian-risk publish --access public --no-git-checks",
    "publish:plugins": "pnpm --filter \"./packages/{express,browser,redis,vpn,logger}\" publish --access public --no-git-checks",
    "publish:all": "pnpm publish:core && pnpm publish:plugins",
    "prepublish:check": "pnpm audit --audit-level moderate && pnpm test:coverage && pnpm build && pnpm lint && pnpm typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.17.0",
    "prettier": "^3.9.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
